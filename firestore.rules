rules_version = '2';

// Cole no Firebase Console → Firestore Database → Regras → Publicar.
// Troque os dois emails abaixo pelos emails de login do Daniel e do Guilherme.
service cloud.firestore {
  match /databases/{database}/documents {

    function isTeam() {
      return request.auth != null
        && request.auth.token.email in [
          'danielvgs.work@gmail.com',
          'guileiteteixeira@gmail.com'
        ];
    }

    function isOwner(uid) {
      return isTeam() && request.auth.uid == uid;
    }

    // Dados compartilhados do estúdio
    match /projetos/{id}    { allow read, write: if isTeam(); }
    match /clientes/{id}    { allow read, write: if isTeam(); }
    match /lancamentos/{id} { allow read, write: if isTeam(); }
    match /eventos/{id}     { allow read, write: if isTeam(); }
    match /atividades/{id}  { allow read, write: if isTeam(); }
    match /leads/{id}       { allow read, write: if isTeam(); }
    match /quadros/{id}     { allow read, write: if isTeam(); }

    // Vendas (Harvey). O agente no PC escreve com a conta de serviço (ignora estas regras).
    match /prospects/{id}   { allow read, write: if isTeam(); }
    match /outbox/{id}      { allow read, write: if isTeam(); }
    // harvey/config: o time edita (pausa, cidades, limites). harvey/status: só o agente escreve.
    match /harvey/{id}      { allow read: if isTeam(); allow write: if isTeam() && id == 'config'; }
    match /harvey_log/{id}  { allow read: if isTeam(); }

    // Instagram (analista). Notas e auditoria vêm do agente; tendências e referências o time também edita.
    match /ig_posts/{id}        { allow read: if isTeam(); }
    match /ig_perfil/{id}       { allow read: if isTeam(); }
    match /ig_referencias/{id}  { allow read, write: if isTeam(); }
    match /ig_tendencias/{id}   { allow read, write: if isTeam(); }

    // Status da sincronização bancária: o script escreve com a conta de serviço (que ignora
    // estas regras); o painel só lê.
    match /sync/{id}        { allow read: if isTeam(); }

    // Dados privados de cada pessoa
    match /projetosPessoais/{uid}/itens/{id} { allow read, write: if isOwner(uid); }
    match /quadros_usuario/{uid}/itens/{id}  { allow read, write: if isOwner(uid); }

    // Todo o resto: fechado
  }
}
