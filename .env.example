# Copie este arquivo para ".env" e preencha com as credenciais do seu projeto Firebase
# (Firebase Console → Configurações do projeto → Seus apps → SDK setup and configuration).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Sincronização bancária (só para rodar `npm run sync:banco` localmente) ---
# NUNCA use o prefixo VITE_ nestas: tudo que começa com VITE_ vai para o navegador.
# No GitHub, as mesmas quatro vão em Settings → Secrets and variables → Actions.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# ID do item da conexão (um por banco), separados por vírgula
PLUGGY_ITEM_IDS=
# Nada anterior a esta data é sincronizado, nem removido — útil quando a conta já
# tinha histórico pessoal antes de virar a conta do estúdio. Formato yyyy-mm-dd.
PLUGGY_SINCE=
# Conteúdo inteiro do JSON da conta de serviço do Firebase, numa linha só
FIREBASE_SERVICE_ACCOUNT=
SYNC_DAYS=30

# --- Trevor: API do Gemini DIRETA, exclusivamente no servidor ---
# Crie a chave em https://aistudio.google.com/apikey. Nunca use VITE_ na chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# O backend usa a conta de serviço acima para validar o login existente.
FIREBASE_PROJECT_ID=entropydash
TREVOR_ALLOWED_EMAILS=danielvgs.work@gmail.com,guileiteteixeira@gmail.com
TREVOR_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
# Na produção, aponte para a URL HTTPS do servidor Node (sem /api/trevor no fim).
# Vazio = mesma origem; o Vite encaminha as chamadas localmente para a porta 8787.
VITE_TREVOR_API_URL=
