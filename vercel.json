{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/trevor.ts": { "maxDuration": 60 },
    "api/trevor/health.ts": { "maxDuration": 60 }
  },
  "routes": [
    { "handle": "filesystem" },
    { "src": "/api/.*", "status": 404 },
    { "src": "/.*", "dest": "/index.html" }
  ]
}
